{
    "experimentalServices": {
        "frontend": {
            "root": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "routePrefix": "/_/backend",
            "entrypoint": "app/main.py"
        }
    },
    "rewrites": [
        { "source": "/chatkit.js", "destination": "/_/backend/chatkit.js" },
        { "source": "/api/:path*", "destination": "/_/backend/api/:path*" },
        { "source": "/health",     "destination": "/_/backend/health" }
    ]
}
